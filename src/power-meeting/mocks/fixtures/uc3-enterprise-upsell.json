  "agendaItems": [
    {
      "id": "agenda-uc3-001",
      "title": "ACMEアップセル機会の現状把握（ARR $240K→$420K）",
      "ownerRoleId": "role-ae",
      "timeBudgetMin": 20,
      "status": "aligned",
      "discussionLog": [
        {
          "id": "disc-uc3-001-a",
          "speaker": "Account Executive",
          "roleId": "role-ae",
          "ts": "2026-04-28T14:05:00Z",
          "text": "ACMEの四半期レビューでSSO問題が解決後、高橋CTOから全社展開の意向が示されました。現在50ユーザーが200以上に拡大予定。Gongコールで確認した主要ニーズはSSO+SCIM、ダッシュボードのカスタマイズ、優先サポートです。",
          "phase": "PHASE1"
        },
        {
          "id": "disc-uc3-001-b",
          "speaker": "CS Manager",
          "roleId": "role-csm",
          "ts": "2026-04-28T14:07:00Z",
          "text": "直近6ヶ月のNPSは障害前の水準に回復しています。eNPS 62、製品満足度4.3/5。ヘルススコアは78で上昇トレンド。解約リスクは低く、拡張への準備は整っています。",
          "phase": "PHASE1"
        },
        {
          "id": "disc-uc3-001-c",
          "speaker": "CEO",
          "roleId": "role-ceo",
          "ts": "2026-04-28T14:09:00Z",
          "text": "ARR $180K拡張は今Qの最重要目標だ。高橋CTOとの次の打ち合わせはいつだ？",
          "phase": "PHASE1"
        },
        {
          "id": "disc-uc3-001-d",
          "speaker": "Account Executive",
          "roleId": "role-ae",
          "ts": "2026-04-28T14:10:00Z",
          "text": "2週間後に提案ミーティングを設定しています。それまでに提案書・ROI計算・競合Battle Cardを準備します。",
          "phase": "PHASE1"
        }
      ],
      "reactions": [
        { "id": "react-uc3-001", "emoji": "🚀", "roleId": "role-ceo",       "ts": "2026-04-28T14:10:00Z" },
        { "id": "react-uc3-002", "emoji": "📈", "roleId": "role-marketing", "ts": "2026-04-28T14:10:00Z" }
