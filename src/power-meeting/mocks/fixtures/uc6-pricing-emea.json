    {
      "id": "agenda-uc6-002",
      "title": "Pricing競争力低下 — 価値ベース再設計方針",
      "ownerRoleId": "role-uc6-cfo",
      "timeBudgetMin": 25,
      "status": "converging",
      "discussionLog": [
        {
          "id": "disc-uc6-002-a",
          "speaker": "CFO",
          "roleId": "role-uc6-cfo",
          "ts": "2026-05-06T07:52:00Z",
          "text": "Value-based Pricingへの移行シナリオを試算しました。7セグメント×3プラン構成で、現ARRベースの客単価が平均22%向上する試算です。ただし既存顧客の移行設計が必要で、承認後3ヶ月の移行期間を想定。",
          "phase": "PHASE2"
        },
        {
          "id": "disc-uc6-002-b",
          "speaker": "Product VP",
          "roleId": "role-uc6-pvp",
          "ts": "2026-05-06T07:55:00Z",
          "text": "プロダクト側では利用量ベースのメタリングを実装済みです。Pricing v3の設計次第で技術的な制約はありません。Stripeでの実装工数は約3週間。既存APIの互換性も担保できます。",
          "phase": "PHASE2"
        },
        {
          "id": "disc-uc6-002-c",
          "speaker": "CRO",
          "roleId": "role-uc6-cro",
          "ts": "2026-05-06T07:57:00Z",
          "text": "Gongデータでは価格交渉で負けた案件の60%が『価値が不明瞭』という理由でした。価値ベースPricingへの移行は営業での説得力も上がる。勝率が最低5〜8pt改善すると見込んでいます。",
          "phase": "PHASE2"
        }
      ],
      "reactions": [
        { "id": "react-uc6-002", "emoji": "⭐", "roleId": "role-uc6-ceo", "ts": "2026-05-06T07:57:00Z" }
      ],
      "positions": [
        { "roleId": "role-uc6-ceo", "stance": "agree",   "weightContribution": 0.25, "ts": "2026-05-06T07:58:00Z", "note": "価値ベースへの移行に同意" },
        { "roleId": "role-uc6-cfo", "stance": "agree",   "weightContribution": 0.30, "ts": "2026-05-06T07:58:00Z" },
        { "roleId": "role-uc6-cro", "stance": "agree",   "weightContribution": 0.30, "ts": "2026-05-06T07:58:00Z" },
        { "roleId": "role-uc6-pvp", "stance": "neutral", "weightContribution": 0.15, "ts": "2026-05-06T07:58:00Z", "note": "既存顧客への移行コミュニケーション設計が必要" }
      ],
      "parked": false,
      "linkedVoiceIds": ["gong-uc6-001"],
      "linkedDecisionIds": ["dec-uc6-strategy"]
